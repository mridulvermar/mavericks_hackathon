# ── Required ──────────────────────────────────────
PORT=5050
CLIENT_URL=http://localhost:5173

# JWT secret — change this to a long random string in production
JWT_SECRET=silverhands_dev_secret_change_in_production

# MongoDB Atlas or local connection string
# REQUIRED for full functionality — app runs in demo mode without this
MONGODB_URI=mongodb://localhost:27017/silverhands

# ── Optional — app uses mocks if missing ──────────
# Google Gemini API (AI features degrade to rule-based fallback)
GEMINI_API_KEY=

# Google Speech-to-Text (voice input degrades to text-only)
GOOGLE_SPEECH_KEY=

# Google Translate API (translations degrade to English-only)
GOOGLE_TRANSLATE_KEY=

# Google Maps API (location features degrade to text input)
GOOGLE_MAPS_KEY=

# Razorpay (payments show demo mode message)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
